{
  "name": "q-recruit",
  "version": "0.1.0",
  "description": "Smart Recruitment & OCR Portal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "retention": "node src/retention.js --run-once",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:db:init": "wrangler d1 execute q-recruit-db --remote --file=db/schema.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^4.21.2",
    "hono": "^4.13.14",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
